# Configuración de SIOC
# Copia este archivo a .env y ajusta los valores
# En Windows: copy env.example .env
# En Linux/Mac: cp env.example .env

# Seguridad
SECRET_KEY=dev-secret-key-change-in-production-use-random-key-here

# Base de datos MySQL/MariaDB
# Para ejecución local (sin Docker): mysql+pymysql://sioc_user:sioc_password@localhost:3308/sioc_db
# Para ejecución con Docker: mysql+pymysql://sioc_user:sioc_password@mysql:3306/sioc_db
DATABASE_URL=mysql+pymysql://sioc_user:sioc_password@localhost:3308/sioc_db

# Uploads
MAX_CONTENT_LENGTH=20971520
UPLOAD_FOLDER=instance/uploads

# Sesiones (poner True en producción con HTTPS)
SESSION_COOKIE_SECURE=False

# Vigencia de momentos de asistencia (capacitaciones): hora local del evento (IANA).
# Por defecto Salta (ARG); mismo valor si todo el sistema opera en esa zona.
CAPACITACIONES_TZ=America/Argentina/Salta

# Usuario administrador por defecto
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_EMAIL=admin@sioc.local

